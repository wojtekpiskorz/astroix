{
  "name": "@wojciechpiskorz/astroix",
  "version": "0.0.31",
  "private": true,
  "description": "Astroix — the Electron parent-app rewrite workspace (private; the npm integration was retired at the retirement gate, ADR-0010, #215)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wojtekpiskorz/astroix.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "check": "biome check .",
    "check:write": "biome check --write .",
    "crap": "node scripts/crap.mjs",
    "crap:ci": "node scripts/crap.mjs --ci",
    "preflight": "node scripts/crap.mjs --preflight",
    "hooks": "node scripts/setup-hooks.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@astrojs/compiler-binding": "^0.4.0",
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "astro": "^7.2.7",
    "happy-dom": "^20.11.6",
    "oxc-parser": "^0.147.0",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
