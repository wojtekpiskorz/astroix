{
  "name": "@wojciechpiskorz/astroix",
  "version": "0.0.13",
  "description": "Dev-only Astro 7 integration — a visual builder for Content Collections content and repo-mapped CSS",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wojtekpiskorz/astroix.git"
  },
  "keywords": [
    "astro",
    "astro-integration",
    "visual-builder",
    "devtools",
    "css"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "bun@1.3.14",
  "imports": {
    "#components/*": "./src/client/components/*",
    "#hooks/*": "./src/client/hooks/*",
    "#lib/*": "./src/client/lib/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup && vite build --config vite.chrome.config.ts",
    "build:chrome": "vite build --config vite.chrome.config.ts",
    "dev": "tsup --watch",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "check:artifact": "node scripts/check-chrome-artifact.mjs",
    "check:publint": "publint",
    "smoke": "node scripts/smoke.mjs",
    "crap": "bun scripts/crap.mjs",
    "crap:ci": "bun scripts/crap.mjs --ci",
    "preflight": "bun scripts/crap.mjs --preflight",
    "hooks": "node scripts/setup-hooks.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci:publish": "bun run build && bun run check:artifact && bun run check:publint && bunx changeset publish",
    "changeset": "changeset"
  },
  "peerDependencies": {
    "astro": "^7.0.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "@astrojs/compiler-binding": "^0.4.0",
    "@base-ui/react": "^1.7.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.6",
    "@vitejs/plugin-react": "^6.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.34.0",
    "postcss": "^8.5.26",
    "shadcn": "^4.19.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@changesets/cli": "^3.0.1",
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/coverage-v8": "^4.1.11",
    "astro": "^7.2.7",
    "happy-dom": "^20.11.6",
    "oxc-parser": "^0.147.0",
    "oxc-transform-react": "^0.147.0",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
