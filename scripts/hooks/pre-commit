#!/bin/sh
# astroix pre-commit: biome blocks on staged lint/format errors (run
# `bun run check:write` and re-stage); the crap4ts CC scan warns, never
# blocks — the hard stops live in `bun run preflight`.
# Wired without a hook manager: git config core.hooksPath scripts/hooks
# (run `bun run hooks` once per clone; see AGENTS.md).
cd "$(git rev-parse --show-toplevel)" || exit 0
if command -v bun >/dev/null 2>&1; then
  bunx biome check --staged || {
    echo "astroix: commit blocked by biome — run 'bun run check:write' and re-stage"
    exit 1
  }
  bun scripts/crap.mjs --staged || echo "astroix: pre-commit CC scan skipped (engine unavailable)"
fi
exit 0
