# deps
node_modules/

# build (the canonical fixture's astro build output lives under e2e/fixture/dist)
dist/
# the web host's bundled client documents (built at host boot, #240)
apps/web/dist-client/
# the desktop host's bundled Electron main (built by the smoke lane, #243)
apps/desktop/dist-main/
# the desktop host's assembled packaged runtime (#244): real artifacts
# built by `npm run assemble:runtime` (the stock Node distribution and the
# bundled runtime) never enter git — only the .gitkeep placeholder does
apps/desktop/resources/*
!apps/desktop/resources/.gitkeep
apps/desktop/.assemble-cache/
# the desktop host's packaging output (#245): the Forge out tree (the
# packaged .app, the ZIP, the candidate manifests) is build evidence,
# never source
apps/desktop/out/
*.tsbuildinfo

# env & secrets
.env
.env.*

# astro dev artifacts (when dogfooding inside this repo)
.astro/

# tests
coverage/
crap-table.md
playwright-report/
test-results/

# os / editor
.DS_Store
*.log

# the early packaged-smoke evidence root (#248, H6): committed by
# exception AFTER the blanket test-results/ and *.log rules — the README
# and one recorded run's evidence files, never raw run scratch (the
# no-rebuild-after-recording law)
!apps/desktop/test-results/
apps/desktop/test-results/*
!apps/desktop/test-results/README.md
!apps/desktop/test-results/early-package-smoke/
apps/desktop/test-results/early-package-smoke/*
!apps/desktop/test-results/early-package-smoke/evidence.json
!apps/desktop/test-results/early-package-smoke/run.log

# the restricted-candidate workflow's evidence root (#259, L2): run
# outputs (manifests, logs, L1 evidence) are build evidence, never
# source — one dry run's manifest.json is committed by exception after
# the blanket rules, the early-package-smoke precedent (#248)
qualification/manifests/*
!qualification/manifests/.gitkeep
!qualification/manifests/dry-run-259/
qualification/manifests/dry-run-259/*
!qualification/manifests/dry-run-259/manifest.json
