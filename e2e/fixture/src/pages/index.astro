---
import { getEntry } from 'astro:content';
import './home.css';

const home = await getEntry('homepage', 'index');
const { title, lead, cta } = home!.data;
---

<section class="hero">
  <h1 class="hero-title">{title}</h1>
  <p class="hero-lead">{lead}</p>
  {
    cta && (
      <a class="hero-cta" href={cta.href}>
        {cta.label}
      </a>
    )
  }
</section>
